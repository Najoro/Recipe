{% extends "admin/admin-base.html.twig" %}

{% block body %}
   
   <div class="row">
      {{form_start(form)}}
      
         <div class="row">
            <div class="col-md-4">{{form_row(form.name)}}</div>
            <div class="col-md-4">{{form_row(form.slug)}}</div>
         </div>
         <div class="row">
            <div class="col-md-12">{{form_row(form.save)}}</div>
         </div>

      {{form_end(form)}}
   </div>

{% endblock %}