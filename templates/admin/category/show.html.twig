{% extends "admin/admin-base.html.twig" %}

{% block title %}Category{% endblock %}
{% block body %}

	<div class="container mt-2">
		<h1>Liste des category</h1>
		<a class="btn btn-primary mb-2" href={{path('admin_category_create')}}>Nouvelle category</a>
		<table class="table table-striped table-inverse table-responsive">
			<thead class="thead-inverse">
				<tr>
					<th>Titre</th>
					<th>Slug</th>
				</tr>
			</thead>
			<tbody>
				{% for categorie in categories %}
					<tr>
						<td scope="row">
							<a href="#">{{categorie.name}}</a>
						</td>
                        <td>
                            <span>{{categorie.slug}}</span>
                        </td>
						<td>
						    <a class="btn btn-warning btn-sm" href={{path("admin_category_edit" , {id: categorie.id} )}}>Editer</a>
							<a class="btn btn-danger btn-sm" href={{path("admin_category_delete" , {id: categorie.id} )}}>Supprimer</a>
						</td>
					</tr>
				{% endfor %}

			</tbody>
		</table>
	</div>

{% endblock %}

